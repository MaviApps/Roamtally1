# GEMINI_API_KEY: Server-side API key for travel insights & itinerary generation.
# Set this in Vercel -> Project Settings -> Environment Variables (never prefix with VITE_).
GEMINI_API_KEY=""

# Supabase configuration (set in Vercel Environment Variables to run on Supabase Auth + PostgreSQL)
# Leave blank to run on the built-in Firebase project in AI Studio preview.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# APP_URL: Live deployed app URL (e.g. https://roamtally.vercel.app)
APP_URL=""
